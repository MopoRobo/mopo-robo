{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nservo_h = Servo(brain.three_wire_port.h)\ncontroller_1 = Controller(PRIMARY)\nmotor_1 = Motor55(Ports.PORT1, False)\nmotor_2 = Motor55(Ports.PORT2, False)\nmotor_11 = Motor55(Ports.PORT11, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\nmyVariable = 0\n\ndef when_started1():\n    global myVariable\n # NOTES:\n    # While this code originally started as movement code from FACTOIDS, it has been changed\n    # enough that I no longer consider it the same\n    # Please upload new code versions to the moporobo github repo here: https://github.com/MopoRobo/mopo-robo\n    # Also make sure that you leave comments whenever you change or add systems\n    # Finally, when removing systems that are not needed anymore, consider commenting them out\n    # instead of deleting them, as they may be useful for next year\n\n    # Completley written by Tyler Roebuck, class of 2029\n    # email me at tyler.roebuck3@gmail.com with any questions\n\n    # Fully Autonomous Robotic Transport (F.A.R.T.) (2026)\n\n    # CODE:\n    # This is the main loop where code is executed\n    while True:\n        #This if-elif loop controls the left motor\n        if controller_1.axis3.position() >= 5:\n            motor_1.spin(REVERSE, (controller_1.axis3.position() / 12.5), VOLT)\n        elif controller_1.axis3.position() <= -5:\n            motor_1.spin(FORWARD, (controller_1.axis3.position() / -12.5), VOLT)\n        else:\n            motor_1.stop()\n        # This if-elif loop controls the right motor\n        if controller_1.axis2.position() >= 5:\n            motor_11.spin(FORWARD, (controller_1.axis2.position() / 12.5), VOLT)\n        elif controller_1.axis2.position() <= -5:\n            motor_11.spin(REVERSE, (controller_1.axis2.position() / -12.5), VOLT)\n        else:\n            motor_11.stop()\n        # This is for the servo motor\n        if controller_1.buttonL1.pressing():\n            servo_h.set_position(-15, DEGREES)\n        else:\n            servo_h.set_position(50, DEGREES)\n        # This loop controls the forklift motor\n        if controller_1.buttonR2.pressing():\n           motor_2.spin(FORWARD, 8, VOLT)\n        elif controller_1.buttonR1.pressing():\n            motor_2.spin(REVERSE, 8, VOLT)\n        else:\n            motor_2.stop()\n        wait(5, MSEC)\nwhen_started1()","textLanguage":"python","robotConfig":[{"port":[8],"name":"servo_h","customName":false,"deviceType":"Servo","deviceClass":"servo","setting":{},"triportSourcePort":22},{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[1],"name":"motor_1","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"false","fwd":"forward","rev":"reverse","id":"partner"},"triportSourcePort":22},{"port":[2],"name":"motor_2","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"false","fwd":"forward","rev":"reverse","id":"partner"},"triportSourcePort":22},{"port":[11],"name":"motor_11","customName":true,"deviceType":"MC55","deviceClass":"motor55","setting":{"reversed":"false","fwd":"forward","rev":"reverse","id":"partner"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.1","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}